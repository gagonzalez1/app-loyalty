# syntax=docker/dockerfile:1
FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS node-runtime

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk upgrade --no-cache \
    && apk add --no-cache libstdc++ 'ca-certificates>=20261020-r0'

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /monitor
COPY scripts/stress-remediation/monitor-health.mjs scripts/stress-remediation/guards.js scripts/stress-remediation/package.json ./

ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/am-p/app-loyalty" \
      org.opencontainers.image.revision="$SOURCE_COMMIT"

USER 65534:65534
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD kill -0 1 || exit 1
ENTRYPOINT ["node"]
CMD ["--max-old-space-size=32", "/monitor/monitor-health.mjs"]
