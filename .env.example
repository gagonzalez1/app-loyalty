# PostgreSQL nuevo y exclusivo para este backend. No apuntar a la base legacy.
POSTGRES_USER=puntazo
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=puntazo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://puntazo:replace-with-url-encoded-password@db:5432/puntazo?sslmode=disable

# Secretos de runtime. Reemplazar; nunca exponerlos en variables EXPO_PUBLIC_*.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=puntazo
QR_PEPPER=replace-with-a-different-32-byte-secret
DEMO_ACCESS_CODE_HASH=replace-with-a-bcrypt-hash

# Comportamiento y orígenes. CORS_ORIGINS acepta una lista separada por comas.
APP_ENV=development
DEMO_SIGNUP_ENABLED=false
GOOGLE_CLIENT_ID=
# Optional web OAuth audience used by the Android app.
GOOGLE_ANDROID_WEB_CLIENT_ID=
CORS_ORIGINS=
EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_APP_URL=http://localhost:8081
MAIL_PROVIDER=disabled
# capture sólo para desarrollo: guarda .eml locales; no envía a destinatarios.
MAIL_CAPTURE_DIRECTORY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Puntazo
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
MAIL_POLL_INTERVAL_SECONDS=5
# Shared Redis delivery budgets; deferred mail retains attempts and encrypted payload.
MAIL_GLOBAL_HOURLY_BUDGET=200
MAIL_RECIPIENT_HOURLY_BUDGET=6
OUTBOX_ENCRYPTION_KEY=replace-with-base64-of-a-separate-32-byte-key
APP_VERSION=dev
GIT_COMMIT=0000000
EXPECTED_SCHEMA_VERSION=0045

# Suscripciones mensuales. Las credenciales son sólo del backend.
MERCADO_PAGO_PROVIDER=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
# Sellos: ARS 25.000 (piloto); Puntos: ARS 20.000. Importes en centavos por sucursal activa.
MERCADO_PAGO_BRANCH_PRICE_CENTS=2500000
MERCADO_PAGO_POINTS_BRANCH_PRICE_CENTS=2000000
MERCADO_PAGO_TIMEOUT_MS=10000
MEDIA_PROVIDER=disabled
S3_ENDPOINT=
# Endpoint público opcional para presigned GET; si queda vacío usa S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
MEDIA_URL_TTL_SECONDS=300
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_UPLOAD_GLOBAL_CONCURRENCY=8
MEDIA_UPLOAD_ACTOR_CONCURRENCY=2
RETENTION_INTERVAL_SECONDS=300
RETENTION_BATCH_SIZE=500
PREVIEW_RETENTION_HOURS=168
IDEMPOTENCY_RETENTION_HOURS=720
SESSION_RETENTION_HOURS=720
IDENTITY_TOKEN_RETENTION_HOURS=168
OUTBOX_REDACT_AFTER_HOURS=168
OUTBOX_RETENTION_HOURS=720
RATE_LIMIT_PROVIDER=memory
REDIS_URL=
RATE_LIMIT_PREFIX=puntazo:development
RATE_LIMIT_TIMEOUT_MS=200
RATE_LIMIT_DEV_FALLBACK=false
PORT=8080
API_PORT=8080
# Legacy hop count is ignored for trust; configure only verified immediate proxy networks.
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_CIDRS=
# One process-wide gate shared by bcrypt generation and comparison (1..64).
PASSWORD_CONCURRENCY=4

# Pending activation: no provider keys are bundled; do not use test keys.
# Enabled requires real keys, bare allowed hostnames and RATE_LIMIT_PROVIDER=redis.
# Receipts and challenge state are shared, single-use, and expire after 120 seconds.
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_ALLOWED_HOSTNAMES=

# Optional server-only Places API (New). Manual Google links work without this key.
GOOGLE_PLACES_API_KEY=

# Sign in with Apple. Server-only: leave all credentials empty until enrollment.
# Client ID is the native bundle com.puntazo.app. The encryption key above protects
# durable revocation tokens; it must be separate from JWT_SECRET and QR_PEPPER.
APPLE_IDENTITY_CLIENT_ID=
APPLE_IDENTITY_TEAM_ID=
APPLE_IDENTITY_KEY_ID=
APPLE_IDENTITY_PRIVATE_KEY_PATH=
APPLE_IDENTITY_REDIRECT_URI=

# Existing-subscription processing and new purchases are separate controls.
# First public iOS release: both false; changing the client edition requires a new
# reviewed App Store build. Never enable purchases via a hidden remote switch.
APPLE_BILLING_ENABLED=false
APPLE_IAP_PURCHASES_ENABLED=false
APPLE_BILLING_ENVIRONMENT=Production
APPLE_BILLING_APP_APPLE_ID=0
APPLE_BILLING_SUBSCRIPTION_GROUP_ID=
APPLE_BILLING_ISSUER_ID=
APPLE_BILLING_KEY_ID=
APPLE_BILLING_PRIVATE_KEY_PATH=
APPLE_BILLING_ROOTS_PATH=
# Only an isolated APP_ENV=development + Xcode environment may trust local tests.
# Never add Xcode certificates to Production or Sandbox roots.
APPLE_BILLING_ALLOW_XCODE=false
